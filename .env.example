LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.5
LLM_CONNECTION_REUSE=true
# Process-local, shared across clients/retries. Coordinate quotas across processes separately.
LLM_REQUESTS_PER_MINUTE=30
# Only 1 is production-approved. Rejected sizes 3/5 are isolated in the research benchmark.
LLM_BATCH_SIZE=1
OPENPARLDATA_BASE_URL=https://api.openparldata.ch
DATA_DIR=data
DATABASE_PATH=data/parltopic.db
TOPIC_CONFIG_DIR=configs/topics
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1400
CHUNK_OVERLAP=200
CLASSIFIER_PROMPT_VERSION=topic-v2
CLASSIFIER_POLICY_VERSION=hybrid-v3
KEYWORD_RESCUE_ENABLED=true
APS_CONTEXT_ENABLED=false
APS_TAXONOMY_PATH=configs/taxonomies/aps_topics.json
APS_MAX_CHAPTERS=4
APS_MAX_TOPICS=8
APS_CONTEXT_MAX_SEGMENTS=8
# Experimental document controls; benchmark changes before promoting them.
KEYWORD_DOCUMENT_GATE_ENABLED=true
RETRIEVAL_PIN_TITLE=false

